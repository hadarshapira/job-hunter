# Copy to .env and change the values
SECRET_KEY=generate-a-long-random-string
DB_PASSWORD=jobhunter
# Google sign-in: OAuth "Web application" client ID from Google Cloud Console (leave empty to hide the button)
GOOGLE_CLIENT_ID=
# Set to false to stop new people from creating accounts
SIGNUP_ENABLED=true
# Set to true once the app is served over HTTPS (Tailscale / cloud)
COOKIE_SECURE=false
