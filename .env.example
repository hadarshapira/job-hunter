# Copy to .env and change the values
SECRET_KEY=generate-a-long-random-string
DB_PASSWORD=jobhunter
# Google sign-in: OAuth "Web application" client ID from Google Cloud Console (leave empty to hide the button)
GOOGLE_CLIENT_ID=
# Gmail tracking: the same Web client's Client secret (from Google Cloud > Credentials)
GOOGLE_CLIENT_SECRET=
# Address Google sends Gmail sign-in back to, e.g. https://mypc.tailnet.ts.net (empty = the address you opened the app at)
PUBLIC_URL=
# JSearch (Google for Jobs) key from RapidAPI; empty = search LinkedIn and company boards only
JSEARCH_API_KEY=
# AI match grades: Anthropic API key from console.anthropic.com (empty = rule-based grade only)
ANTHROPIC_API_KEY=
# Optional: which Claude model grades jobs, and how hard it thinks (low | medium | high). Changing either re-grades all jobs.
AI_MODEL=claude-sonnet-5-5
AI_EFFORT=medium
# Contact email shown on the public home + privacy pages that Google's OAuth review asks for
CONTACT_EMAIL=
# Set to false to stop new people from creating accounts
SIGNUP_ENABLED=true
# Set to true once the app is served over HTTPS (Tailscale / cloud)
COOKIE_SECURE=false
